# Server port (default 3377, chosen to avoid conflicts with other services)
PORT=3377

# JWT signing secret - CHANGE THIS to a random 64-character string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-random-64-char-string

# SQLite database path (relative to project root). Holds entries and media
# metadata — not the media bytes, so it stays small.
DB_PATH=./data/journals.db

# ─── Media storage ───────────────────────────────────────────────
# Where photo and video BYTES are stored, as files (one directory per user).
# This is the path that grows: point it at an external SSD if the Pi's SD card
# is small. Blobs are addressed by id, so the directory can be moved wholesale.
# Back this up together with DB_PATH — either one alone is incomplete.
MEDIA_PATH=./data/media

# Largest single file the server will accept, in bytes. Default 2 GB.
# Anything larger is refused with 413 and the client stops retrying it.
MAX_MEDIA_BYTES=2147483648

# Environment
NODE_ENV=production

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# ─── AI assistant ────────────────────────────────────────────────
# OpenAI API key for the built-in journaling assistant. This is the ONLY place
# the key is stored — the desktop apps no longer hold it. The apps call
# POST /api/llm/chat and the server forwards the request to OpenAI using this
# key. Leave blank to disable the AI feature server-wide.
#
# This file is read once, at server startup, and only the copy that sits in the
# install directory (next to package.json) counts. After setting this, restart
# the server, then check `curl localhost:3377/api/health` — it reports
# "ai":"configured" once the running process actually has the key. Until then
# the desktop apps get a 503 and say the assistant isn't set up on the server.
OPENAI_API_KEY=

# Optional: override the OpenAI-compatible API base URL (e.g. a proxy).
# OPENAI_BASE_URL=https://api.openai.com/v1
